{
  "name": "vermoegensnavigator",
  "version": "0.18.2",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "bash scripts/build-github-pages.sh",
    "build:github": "bash scripts/build-github-pages.sh",
    "typecheck": "tsc -p tsconfig.github.json --noEmit",
    "test:multi-depot": "esbuild scripts/verify-multi-depot.ts --bundle --platform=node --format=esm --outfile=/tmp/vermoegensnavigator-verify-multi-depot.mjs && node /tmp/vermoegensnavigator-verify-multi-depot.mjs",
    "test:modelportfolio": "esbuild scripts/verify-modelportfolio.ts --bundle --platform=node --format=esm --outfile=/tmp/vermoegensnavigator-verify-modelportfolio.mjs && node /tmp/vermoegensnavigator-verify-modelportfolio.mjs",
    "test:3b": "esbuild scripts/verify-3b.ts --bundle --platform=node --format=esm --outfile=/tmp/vermoegensnavigator-verify-3b.mjs && node /tmp/vermoegensnavigator-verify-3b.mjs",
    "test:4b": "esbuild scripts/verify-4b.ts --bundle --platform=node --format=esm --outfile=/tmp/vermoegensnavigator-verify-4b.mjs && node /tmp/vermoegensnavigator-verify-4b.mjs",
    "test:risk-v2": "esbuild scripts/verify-risk-v2.ts --bundle --platform=node --format=esm --outfile=/tmp/vermoegensnavigator-verify-risk-v2.mjs && node /tmp/vermoegensnavigator-verify-risk-v2.mjs",
    "test": "npm run typecheck && npm run build",
    "test:cp1": "esbuild scripts/verify-cp1.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=/tmp/vermoegensnavigator-verify-cp1.cjs && node /tmp/vermoegensnavigator-verify-cp1.cjs",
    "test:bond-v2": "esbuild scripts/verify-bond-v2.ts --bundle --platform=node --format=esm --outfile=/tmp/vermoegensnavigator-verify-bond-v2.mjs && node /tmp/vermoegensnavigator-verify-bond-v2.mjs",
    "test:cp3": "esbuild scripts/verify-cp3.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=/tmp/vermoegensnavigator-verify-cp3.cjs && node /tmp/vermoegensnavigator-verify-cp3.cjs",
    "test:cp4": "esbuild scripts/verify-cp4.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=/tmp/vermoegensnavigator-verify-cp4.cjs && node /tmp/vermoegensnavigator-verify-cp4.cjs",
    "test:bond-final": "esbuild scripts/verify-bond-final.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=/tmp/vermoegensnavigator-verify-bond-final.cjs && node /tmp/vermoegensnavigator-verify-bond-final.cjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "VermögensNavigator"
}
